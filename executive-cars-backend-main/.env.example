PORT=5082
# Development uses the single local Docker replica set. Atlas is production only.
MONGO_URI=mongodb://127.0.0.1:27017/executivecars_dev?directConnection=true&replicaSet=executivecars-local
# Tests reset only this explicit local database. Never use a dev/production URI.
TEST_MONGO_URI=mongodb://127.0.0.1:27017/executivecars_test?directConnection=true&replicaSet=executivecars-local

# Master application secret (CSRF, OTP and document-link keys are derived from it). 32+ random characters in production.
JWT_SECRET=your_super_secret_jwt_key_change_this
# Server-side session lifetimes. Idle = time without activity, absolute = hard maximum since sign-in.
SESSION_CUSTOMER_IDLE_DAYS=7
SESSION_CUSTOMER_ABSOLUTE_DAYS=14
SESSION_ADMIN_IDLE_MINUTES=30
SESSION_ADMIN_ABSOLUTE_HOURS=8
# Breached-password check (Have I Been Pwned range API, k-anonymity, fails open). Default: on in production, off elsewhere.
# HIBP_ENABLED=true
# strict (default) or lax; use lax only if a real-browser check shows strict breaks sign-in on your domain.
# SESSION_COOKIE_SAMESITE=strict

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Set true on ephemeral hosting so startup fails if durable uploads are missing.
REQUIRE_CLOUDINARY=false

# Choose development (local demo), smtp (local Gmail), or resend (Render Free).
EMAIL_DELIVERY_MODE=smtp
# Required when EMAIL_DELIVERY_MODE=resend. Use an address on a verified Resend domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Only needed when EMAIL_DELIVERY_MODE=smtp.
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_APP_PASSWORD=

# Local FYP mode. For a production deployment set APP_MODE=production, NODE_ENV=production,
# HTTPS CLIENT_URL(S), Resend email, a strong secret, and keep every demo seed flag disabled.
APP_MODE=demo
# The only payment provider is the sandbox: a complete payment flow (card, wallet, bank transfer, invoices) that moves no money.
# It accepts published test credentials only. A real provider would replace it in src/services.
PAYMENT_PROVIDER=sandbox

CLIENT_URL=http://localhost:5173
# Optional comma-separated extra origins, e.g. local + deployed frontends
CLIENT_URLS=http://127.0.0.1:5173

# How many reverse proxies sit in front of the API (1 to 5). The rate limits and the sign-in delay are kept per client
# address, which the API reads from the proxies' X-Forwarded-For header. Render alone is 1; Vercel proxying to Render
# is normally 2. Too low and every visitor shares one address (one person's failed sign-ins slow everybody down); too
# high and a visitor can choose their own. Check after deploying: sign in, open Security (customers) or Admin > Security
# and compare the address shown in "Recent activity" with your own public address.
TRUST_PROXY_HOPS=1

# Optional conflict-safe identities for the tagged demo seed. Override these
# when the default addresses already belong to untagged accounts.
DEMO_ADMIN_EMAIL=admin@executivecars.pk
DEMO_ADMIN_PASSWORD=Admin@12345
DEMO_MEMBER_EMAIL=member@executivecars.pk
DEMO_MEMBER_PASSWORD=Member@12345
DEMO_USER_EMAIL=user@executivecars.pk
DEMO_USER_PASSWORD=User@12345
DEMO_BIDDER_EMAIL=bidder@executivecars.pk
DEMO_BIDDER_PASSWORD=Bidder@12345

# Explicitly enable only for local FYP demonstration data; never enable in production.
ENABLE_DEMO_SEED=false

# Internal FYP membership simulation only. No financial transaction occurs.
AUCTION_MEMBERSHIP_PRICE=4999

GROQ_API_KEY=
# Must be a Groq model available to this project and support the tool-calling contract.
GROQ_MODEL=openai/gpt-oss-20b
# Cache the safe exact-model capability check (minimum 30 seconds).
CHAT_CAPABILITY_CACHE_MS=300000

ML_API_URL=http://127.0.0.1:8000
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_KEY=
