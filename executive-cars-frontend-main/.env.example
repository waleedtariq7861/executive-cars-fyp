# Leave public URLs empty during local development to use the Vite proxy.
VITE_API_URL=
VITE_SOCKET_URL=
# Set both values only for a deliberately branded FYP demonstration build.
VITE_APP_MODE=production

# Public business contact details (optional; shown only when configured)
VITE_BUSINESS_CITY=Pakistan
VITE_BUSINESS_ADDRESS=
VITE_CONTACT_PHONE=
VITE_CONTACT_PHONE_LABEL=
VITE_CONTACT_EMAIL=
